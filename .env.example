# Copy to `.env` (repo root) and adjust. Every value below is a LOCAL-DEV placeholder.
# The server refuses to start in production while any secret still contains "change-me".

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local docker-compose services (`docker compose up -d db redis`)
DATABASE_URL=postgresql://finagent:finagent@localhost:5432/finagent?schema=public
REDIS_URL=redis://localhost:6379

# Auth: generate real secrets with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# AES-256-GCM key for the PII masking vault and webhook secrets: 32 bytes, base64.
# Generate a real one with `openssl rand -base64 32`. This placeholder decodes to "dev-only-masking-key-change-me!!".
MASKING_KEY=ZGV2LW9ubHktbWFza2luZy1rZXktY2hhbmdlLW1lISE=

# Comma-separated allowlist of browser origins (the future React client)
CORS_ORIGINS=http://localhost:5173

# LLM: `anthropic` (needs ANTHROPIC_API_KEY) or `mock` (deterministic, no network)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
AGENT_MAX_ITERATIONS=8

# Upload limits
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_UNCOMPRESSED_BYTES=209715200
UPLOAD_MAX_SHEETS=20
UPLOAD_MAX_ROWS=200000
STORAGE_DIR=./storage

# Analysis
ANOMALY_THRESHOLD_AMOUNT=10000

# Rate limits (requests per window)
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_ANALYSIS_MAX=30

# Worker concurrency
QUEUE_CONCURRENCY_INGEST=2
QUEUE_CONCURRENCY_ANALYZE=2
QUEUE_CONCURRENCY_WEBHOOK=5

# Demo users created by `npm run db:seed` (local dev only)
SEED_ADMIN_EMAIL=admin@finagent.local
SEED_ADMIN_PASSWORD=Admin-Dev-Passw0rd!
SEED_MANAGER_EMAIL=manager@finagent.local
SEED_MANAGER_PASSWORD=Manager-Dev-Passw0rd!
SEED_ANALYST_EMAIL=analyst@finagent.local
SEED_ANALYST_PASSWORD=Analyst-Dev-Passw0rd!
