{
  "name": "finagent-server",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "npm run dev:api & npm run dev:worker & wait",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "sample:xlsx": "tsx scripts/generate-sample-xlsx.ts",
    "smoke": "tsx scripts/smoke.ts",
    "postinstall": "prisma generate"
  },
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.15",
    "cors": "^2.8.6",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "license": "UNLICENSED"
}
